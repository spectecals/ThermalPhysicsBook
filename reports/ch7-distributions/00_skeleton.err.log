    Line2D([0],[0], color='grey', linestyle='-',  label=r"$v_p$"),
    Line2D([0],[0], color='grey', linestyle='--', label=r"$\langle v 
angle$"),
    Line2D([0],[0], color='grey', linestyle=':',  label=r"$v_\mathrm{rms}$"),
]
leg1 = ax.legend(frameon=False, fontsize=9, loc='upper right')
ax.add_artist(leg1)
ax.legend(handles=style_legend, frameon=False, fontsize=9, loc='center right')

ax.set_xlabel(r"Speed $v$ (m s$^{-1}$)")
ax.set_ylabel(r"$f(v)$")
ax.grid(alpha=0.2)
plt.tight_layout()
plt.figtext(0.5, -0.04,
    r"Figure 3.1. Maxwell–Boltzmann speed distributions. "
    r"Vertical lines mark $v_p$ (solid), $\langle v
angle$ (dashed), $v_\mathrm{rms}$ (dotted).",
