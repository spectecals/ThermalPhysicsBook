kB = 1.38e-23
COLORS = ["#1E88E5", "#D81B60", "#FFC107", "#43A047"]

def f_MB(v, T, m):
    return 4*np.pi * (m/(2*np.pi*kB*T))**1.5 * v**2 * np.exp(-m*v**2/(2*kB*T))

m_N2 = 28e-3 / 6.022e23
v = np.linspace(0, 1600, 800)

cases = [
    (300, m_N2,             r"$N_2$, 300 K"),
    (500, m_N2,             r"$N_2$, 500 K"),
    (300, 2e-3/6.022e23,   r"$H_2$, 300 K"),
    (300, 32e-3/6.022e23,  r"$O_2$, 300 K"),
]

fig, ax = plt.subplots(figsize=(8, 4))
for (T, m, lab), col in zip(cases, COLORS):
    y = f_MB(v, T, m)
    ax.plot(v, y, color=col, linewidth=2, label=lab)
    # mark the three characteristic speeds
    vp   = np.sqrt(2*kB*T/m)
    vmean= np.sqrt(8*kB*T/(np.pi*m))
    vrms = np.sqrt(3*kB*T/m)
    for spd, ls in [(vp, '-'), (vmean, '--'), (vrms, ':')]:
        ax.axvline(spd, color=col, linestyle=ls, linewidth=0.8, alpha=0.6)

# Legend for line styles
