    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"\\n\",\n",
    "    \"def binary_entropy_bits(p: np.ndarray) -> np.ndarray:\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Binary entropy H(p) in bits: -p log2 p - (1-p) log2 (1-p)\\n\",\n",
    "    \"    Handles p=0 or 1 safely.\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    p = np.asarray(p, dtype=float)\\n\",\n",
    "    \"    p = np.clip(p, 1e-12, 1 - 1e-12)\\n\",\n",
    "    \"    return -(p * np.log2(p) + (1 - p) * np.log2(1 - p))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Data\\n\",\n",
    "    \"p = np.linspace(0.0, 1.0, 2001)\\n\",\n",
    "    \"H = binary_entropy_bits(p)\\n\",\n",
    "    \"N_modes = 2 ** H  # \\\"effective number of outcomes/modes\\\" (perplexity for base-2 entropy)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Style (kept simple, close to textbook-ish look)\\n\",\n",
    "    \"plt.rcParams.update({\\n\",\n",
    "    \"    \\\"font.size\\\": 11,\\n\",\n",
    "    \"    \\\"axes.labelsize\\\": 12,\\n\",\n",
    "    \"    \\\"axes.titlesize\\\": 12,\\n\",\n",
    "    \"    \\\"axes.linewidth\\\": 1.0,\\n\",\n",
    "    \"    \\\"xtick.direction\\\": \\\"out\\\",\\n\",\n",
    "    \"    \\\"ytick.direction\\\": \\\"out\\\",\\n\",\n",
    "    \"})\\n\",\n",
    "    \"\\n\",\n",
    "    \"# -------- Figure 1: Entropy vs p --------\\n\",\n",
    "    \"fig1, ax1 = plt.subplots(figsize=(6.2, 4.2), dpi=200)\\n\",\n",
    "    \"ax1.plot(p, H, linewidth=2.0)\\n\",\n",
    "    \"ax1.set_xlim(0, 1)\\n\",\n",
    "    \"ax1.set_ylim(0, 1.0)\\n\",\n",
    "    \"ax1.set_xlabel(\\\"Probability of getting heads\\\")\\n\",\n",
    "    \"ax1.set_ylabel(\\\"Entropy\\\")\\n\",\n",
    "    \"ax1.set_xticks(np.linspace(0, 1, 6))\\n\",\n",
    "    \"ax1.set_yticks(np.linspace(0, 1, 6))\\n\",\n",
    "    \"ax1.grid(False)\\n\",\n",
    "    \"fig1.tight_layout()\\n\",\n",
    "    \"fig1.savefig(\\\"entropy_vs_p.png\\\", bbox_inches=\\\"tight\\\")\\n\",\n",
    "    \"plt.close(fig1)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# -------- Figure 2: Number of modes vs p --------\\n\",\n",
    "    \"fig2, ax2 = plt.subplots(figsize=(6.2, 4.2), dpi=200)\\n\",\n",
    "    \"ax2.plot(p, N_modes, linewidth=2.0)\\n\",\n",
    "    \"ax2.set_xlim(0, 1)\\n\",\n",
    "    \"ax2.set_ylim(0, 2.05)\\n\",\n",
    "    \"ax2.set_xlabel(\\\"Probability of getting heads\\\")\\n\",\n",
    "    \"ax2.set_ylabel(\\\"Number of modes\\\")\\n\",\n",
    "    \"ax2.set_xticks(np.linspace(0, 1, 6))\\n\",\n",
    "    \"ax2.set_yticks(np.linspace(0, 2, 5))\\n\",\n",
    "    \"ax2.grid(False)\\n\",\n",
    "    \"fig2.tight_layout()\\n\",\n",
    "    \"fig2.savefig(\\\"modes_vs_p.png\\\", bbox_inches=\\\"tight\\\")\\n\",\n",
    "    \"plt.close(fig2)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# -------- Combined side-by-side (optional) --------\\n\",\n",
    "    \"fig, (axL, axR) = plt.subplots(1, 2, figsize=(12.6, 4.2), dpi=200)\\n\",\n",
    "    \"\\n\",\n",
    "    \"axL.plot(p, H, linewidth=2.0)\\n\",\n",
    "    \"axL.set_xlim(0, 1); axL.set_ylim(0, 1.0)\\n\",\n",
    "    \"axL.set_xlabel(\\\"Probability of getting heads\\\")\\n\",\n",
    "    \"axL.set_ylabel(\\\"Entropy\\\")\\n\",\n",
    "    \"axL.set_xticks(np.linspace(0, 1, 6))\\n\",\n",
    "    \"axL.set_yticks(np.linspace(0, 1, 6))\\n\",\n",
    "    \"axL.grid(False)\\n\",\n",
    "    \"\\n\",\n",
    "    \"axR.plot(p, N_modes, linewidth=2.0)\\n\",\n",
    "    \"axR.set_xlim(0, 1); axR.set_ylim(0, 2.05)\\n\",\n",
    "    \"axR.set_xlabel(\\\"Probability of getting heads\\\")\\n\",\n",
    "    \"axR.set_ylabel(\\\"Number of modes\\\")\\n\",\n",
    "    \"axR.set_xticks(np.linspace(0, 1, 6))\\n\",\n",
    "    \"axR.set_yticks(np.linspace(0, 2, 5))\\n\",\n",
    "    \"axR.grid(False)\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig.tight_layout()\\n\",\n",
    "    \"fig.savefig(\\\"entropy_and_modes_side_by_side.png\\\", bbox_inches=\\\"tight\\\")\\n\",\n",
    "    \"plt.close(fig)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"Saved: entropy_vs_p.png, modes_vs_p.png, entropy_and_modes_side_by_side.png\\\")\"\n",
    "   ],\n",
