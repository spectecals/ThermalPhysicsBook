    "    \"    \\\"figure.facecolor\\\": \\\"white\\\",\\n\",\n",
    "    \"    \\\"axes.facecolor\\\": \\\"white\\\",\\n\",\n",
    "    \"})\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Quick sanity check\\n\",\n",
    "    \"plt.figure()\\n\",\n",
    "    \"plt.plot([0, 1], [0, 1], color=\\\"black\\\", linewidth=0.9)\\n\",\n",
