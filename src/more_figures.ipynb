    "    \"\\n\",\n",
    "    \"    # Axes + ticks styling\\n\",\n",
    "    \"    \\\"axes.edgecolor\\\": \\\"black\\\",\\n\",\n",
    "    \"    \\\"axes.linewidth\\\": 0.8,\\n\",\n",
    "    \"    \\\"xtick.color\\\": \\\"black\\\",\\n\",\n",
