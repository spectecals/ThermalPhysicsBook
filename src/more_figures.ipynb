    "    \"    \\\"xtick.major.width\\\": 0.8,\\n\",\n",
    "    \"    \\\"ytick.major.width\\\": 0.8,\\n\",\n",
    "    \"    \\\"xtick.minor.size\\\": 2.5,\\n\",\n",
    "    \"    \\\"ytick.minor.size\\\": 2.5,\\n\",\n",
    "    \"    \\\"xtick.minor.width\\\": 0.6,\\n\",\n",
    "    \"    \\\"ytick.minor.width\\\": 0.6,\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # No grid\\n\",\n",
    "    \"    \\\"axes.grid\\\": False,\\n\",\n",
    "    \"})\\n\",\n",
    "    \"\\n\",\n",
    "    \"def apply_axes_style(ax):\\n\",\n",
    "    \"    # Thin black spines on all sides (Matlab-like “box on”)\\n\",\n",
    "    \"    for spine in ax.spines.values():\\n\",\n",
    "    \"        spine.set_linewidth(0.8)\\n\",\n",
    "    \"        spine.set_color(\\\"black\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Tick marks but no grid; add minor ticks for elegance\\n\",\n",
    "    \"    ax.tick_params(which=\\\"both\\\", top=False, right=False)  # set True if you want top/right ticks\\n\",\n",
    "    \"    ax.xaxis.set_minor_locator(AutoMinorLocator(2))\\n\",\n",
    "    \"    ax.yaxis.set_minor_locator(AutoMinorLocator(2))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ----- Data -----\\n\",\n",
    "    \"p = np.linspace(0, 1, 2001)\\n\",\n",
    "    \"H = binary_entropy_bits(p)\\n\",\n",
    "    \"N_modes = 2 ** H\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ----- Plot 1: Entropy -----\\n\",\n",
    "    \"fig1, ax1 = plt.subplots(figsize=(6.2, 4.2), dpi=300)\\n\",\n",
    "    \"ax1.plot(p, H, color=\\\"black\\\", linewidth=0.9)\\n\",\n",
    "    \"ax1.set_xlim(0, 1)\\n\",\n",
    "    \"ax1.set_ylim(0, 1.0)\\n\",\n",
    "    \"ax1.set_xlabel(\\\"Probability of getting heads\\\")\\n\",\n",
    "    \"ax1.set_ylabel(\\\"Entropy\\\")\\n\",\n",
    "    \"ax1.set_xticks(np.linspace(0, 1, 6))\\n\",\n",
    "    \"ax1.set_yticks(np.linspace(0, 1, 6))\\n\",\n",
    "    \"ax1.xaxis.set_major_formatter(FormatStrFormatter(\\\"%.1f\\\"))\\n\",\n",
    "    \"ax1.yaxis.set_major_formatter(FormatStrFormatter(\\\"%.1f\\\"))\\n\",\n",
    "    \"apply_axes_style(ax1)\\n\",\n",
    "    \"fig1.tight_layout()\\n\",\n",
    "    \"fig1.savefig(\\\"entropy_vs_p_times.png\\\", bbox_inches=\\\"tight\\\")\\n\",\n",
    "    \"plt.close(fig1)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ----- Plot 2: Number of modes -----\\n\",\n",
    "    \"fig2, ax2 = plt.subplots(figsize=(6.2, 4.2), dpi=300)\\n\",\n",
    "    \"ax2.plot(p, N_modes, color=\\\"black\\\", linewidth=0.9)\\n\",\n",
    "    \"ax2.set_xlim(0, 1)\\n\",\n",
    "    \"ax2.set_ylim(0, 2.05)\\n\",\n",
    "    \"ax2.set_xlabel(\\\"Probability of getting heads\\\")\\n\",\n",
    "    \"ax2.set_ylabel(\\\"Number of modes\\\")\\n\",\n",
    "    \"ax2.set_xticks(np.linspace(0, 1, 6))\\n\",\n",
    "    \"ax2.set_yticks(np.linspace(0, 2, 5))\\n\",\n",
    "    \"ax2.xaxis.set_major_formatter(FormatStrFormatter(\\\"%.1f\\\"))\\n\",\n",
    "    \"ax2.yaxis.set_major_formatter(FormatStrFormatter(\\\"%.1f\\\"))\\n\",\n",
    "    \"apply_axes_style(ax2)\\n\",\n",
    "    \"fig2.tight_layout()\\n\",\n",
    "    \"fig2.savefig(\\\"modes_vs_p_times.png\\\", bbox_inches=\\\"tight\\\")\\n\",\n",
    "    \"plt.close(fig2)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"Saved: entropy_vs_p_times.png, modes_vs_p_times.png\\\")\"\n",
