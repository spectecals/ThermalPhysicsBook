    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ---------------- Data ----------------\\n\",\n",
    "    \"# Dimensionless pressure axis\\n\",\n",
    "    \"p = np.linspace(0, 1.2, 500)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Compressibility factor curves\\n\",\n",
    "    \"Z_perfect = np.ones_like(p)\\n\",\n",
    "    \"\\n\",\n",
    "    \"Z_lowT  = 1 - 0.6*p + 0.8*p**2      # dip then rise (attractions dominate first)\\n\",\n",
    "    \"Z_boyle = 1 + 0.8*p**2              # flat initially, then rises\\n\",\n",
    "    \"Z_highT = 1 + 0.6*p + 0.6*p**2      # always above 1\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ---------------- Figure ----------------\\n\",\n",
    "    \"fig, ax = plt.subplots(figsize=(5.2, 5.2), dpi=160)\\n\",\n",
    "    \"\\n\",\n",
    "    \"ax.plot(p, Z_highT,  lw=2.5, color=\\\"#8e3b6d\\\", label=\\\"Higher temperature\\\")\\n\",\n",
    "    \"ax.plot(p, Z_boyle,  lw=2.5, color=\\\"#2f7f73\\\", label=\\\"Boyle temperature\\\")\\n\",\n",
    "    \"ax.plot(p, Z_lowT,   lw=2.5, color=\\\"#3a6fb0\\\", label=\\\"Lower temperature\\\")\\n\",\n",
    "    \"ax.plot(p, Z_perfect, lw=2.0, color=\\\"#7a3d7a\\\", ls=\\\"--\\\", label=\\\"Perfect gas\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ---------------- Axes ----------------\\n\",\n",
    "    \"ax.set_xlim(0, 1.2)\\n\",\n",
    "    \"ax.set_ylim(0.7, 2.0)\\n\",\n",
    "    \"\\n\",\n",
    "    \"ax.tick_params(axis=\\\"both\\\", which=\\\"both\\\",\\n\",\n",
    "    \"               labelbottom=False, labelleft=False,\\n\",\n",
    "    \"               length=0)\\n\",\n",
    "    \"\\n\",\n",
    "    \"ax.set_xlabel(r\\\"Pressure, $p$\\\")\\n\",\n",
    "    \"ax.set_ylabel(r\\\"Compression factor, $Z$\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"ax.axhline(1.0, color=\\\"black\\\", lw=1.0, alpha=0.5)\\n\",\n",
    "    \"\\n\",\n",
    "    \"ax.grid(True, ls=\\\":\\\", lw=1.0, alpha=0.6)\\n\",\n",
