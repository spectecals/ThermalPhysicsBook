    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"OG_COLORS = [\\\"#EE7733\\\", \\\"#EEAA33\\\", \\\"#228833\\\", \\\"#66CC55\\\"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"V = np.linspace(0.2, 3, 500)\\n\",\n",
    "    \"temperatures = [200, 300, 500, 800]\\n\",\n",
    "    \"n = 1\\n\",\n",
    "    \"R = 1\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.figure(figsize=(8, 5))\\n\",\n",
    "    \"\\n\",\n",
    "    \"for T, col in zip(temperatures, OG_COLORS):\\n\",\n",
    "    \"    P = n * R * T / V\\n\",\n",
    "    \"    plt.plot(V, P, color=col, linewidth=2, label=f\\\"$T = {T}$\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.ylim(0, 2500)\\n\",\n",
    "    \"plt.xlabel(\\\"Volume $V$ [arb. units]\\\")\\n\",\n",
    "    \"plt.ylabel(\\\"Pressure $P$ [arb. units]\\\")\\n\",\n",
    "    \"plt.legend(title=\\\"Temperatures\\\", loc=\\\"upper right\\\")\\n\",\n",
    "    \"plt.grid(alpha=0.2)\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.figtext(\\n\",\n",
    "    \"    x=0.55, y=-0.04,\\n\",\n",
