    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-02-02T18:32:26.513895500Z\",\n",
    "     \"start_time\": \"2026-02-02T18:32:25.913306800Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"import matplotlib.ticker as mticker\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ---------------- Data ----------------\\n\",\n",
    "    \"T_min = 1e-2\\n\",\n",
    "    \"T = np.logspace(np.log10(T_min), np.log10(1e4), 2000)\\n\",\n",
    "    \"\\n\",\n",
    "    \"def logistic_on_logT(T, T0, width_decades):\\n\",\n",
    "    \"    x = np.log10(T)\\n\",\n",
    "    \"    x0 = np.log10(T0)\\n\",\n",
    "    \"    k = 1.0 / width_decades\\n\",\n",
    "    \"    return 1.0 / (1.0 + np.exp(-k * (x - x0)))\\n\",\n",
    "    \"\\n\",\n",
    "    \"Cv = (\\n\",\n",
    "    \"    1.5\\n\",\n",
    "    \"    + logistic_on_logT(T, T0=90,   width_decades=0.07)   # rotation\\n\",\n",
    "    \"    + logistic_on_logT(T, T0=3500, width_decades=0.09)   # vibration\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"def cv_at(T_query):\\n\",\n",
    "    \"    idx = np.argmin(np.abs(T - T_query))\\n\",\n",
    "    \"    return Cv[idx]\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ---------------- Figure ----------------\\n\",\n",
    "    \"fig, ax = plt.subplots(figsize=(8.8, 4.8), dpi=180)\\n\",\n",
    "    \"fig.patch.set_facecolor(\\\"white\\\")\\n\",\n",
    "    \"ax.set_facecolor(\\\"white\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# so we use symlog with a small linear region near 0.\\n\",\n",
    "    \"ax.set_xscale(\\\"symlog\\\", linthresh=25, linscale=0.25, base=10)\\n\",\n",
    "    \"ax.set_xlim(0, 1e4)\\n\",\n",
    "    \"ax.set_ylim(0.45, 3.85)  # tiny extra headroom for captions\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ---------------- Curve segments ----------------\\n\",\n",
    "    \"T_low = 25\\n\",\n",
    "    \"T_high = 2500\\n\",\n",
    "    \"\\n\",\n",
    "    \"mask_low = T < T_low\\n\",\n",
    "    \"mask_mid = (T >= T_low) & (T < T_high)\\n\",\n",
    "    \"mask_high = T >= T_high\\n\",\n",
    "    \"\\n\",\n",
    "    \"ax.plot(T[mask_low],  Cv[mask_low],  color=\\\"#8b6cff\\\", lw=2.6, ls=\\\"--\\\", alpha=0.9)\\n\",\n",
    "    \"ax.plot(T[mask_mid],  Cv[mask_mid],  color=\\\"#8b6cff\\\", lw=2.6)\\n\",\n",
    "    \"ax.plot(T[mask_high], Cv[mask_high], color=\\\"#8b6cff\\\", lw=2.6, ls=\\\"--\\\", alpha=0.9)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ---------------- X axis ----------------\\n\",\n",
    "    \"major_ticks = [0, 25, 50, 100, 250, 500, 1000, 2500, 5000, 10000]\\n\",\n",
    "    \"ax.xaxis.set_major_locator(mticker.FixedLocator(major_ticks))\\n\",\n",
    "    \"ax.xaxis.set_major_formatter(\\n\",\n",
    "    \"    mticker.FixedFormatter([\\\"0\\\", \\\"25\\\", \\\"50\\\", \\\"100\\\", \\\"250\\\", \\\"500\\\", \\\"1000\\\", \\\"2500\\\", \\\"5000\\\", \\\"10000\\\"])\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"ax.tick_params(axis=\\\"x\\\", which=\\\"major\\\", direction=\\\"out\\\", length=7, width=1.2, colors=\\\"black\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ---------------- Y axis ----------------\\n\",\n",
    "    \"yticks = np.arange(0.5, 3.6, 0.5)\\n\",\n",
    "    \"ax.set_yticks(yticks)\\n\",\n",
    "    \"\\n\",\n",
    "    \"def ytick_label(v):\\n\",\n",
    "    \"    if abs(v - round(v)) < 1e-6:\\n\",\n",
    "    \"        n = int(round(v))\\n\",\n",
    "    \"        return r\\\"$R$\\\" if n == 1 else rf\\\"${n}R$\\\"\\n\",\n",
    "    \"    else:\\n\",\n",
    "    \"        n2 = int(round(2 * v))\\n\",\n",
    "    \"        return rf\\\"$\\\\frac{{{n2}R}}{{2}}$\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"ax.set_yticklabels([ytick_label(v) for v in yticks], color=\\\"black\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"ax.set_xlabel(r\\\"$T\\\\;(\\\\mathrm{K})$\\\", color=\\\"black\\\")\\n\",\n",
    "    \"ax.set_ylabel(r\\\"$C_V$\\\", color=\\\"black\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"ax.tick_params(axis=\\\"y\\\", colors=\\\"black\\\")\\n\",\n",
    "    \"for spine in ax.spines.values():\\n\",\n",
    "    \"    spine.set_color(\\\"black\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ---------------- Horizontal guides ----------------\\n\",\n",
    "    \"T_stub = 6.0\\n\",\n",
    "    \"ax.hlines(y=1.5, xmin=0, xmax=T_stub, lw=1.5, ls=\\\"--\\\", color=\\\"black\\\", alpha=0.6)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Main 3R/2 guide (from 25 onward)\\n\",\n",
    "    \"ax.hlines(y=1.5, xmin=25, xmax=1e4, lw=1.5, ls=\\\"--\\\", color=\\\"black\\\", alpha=0.6)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 5R/2 guide (from 250 onward)\\n\",\n",
    "    \"ax.hlines(y=2.5, xmin=250, xmax=1e4, lw=1.5, ls=\\\"--\\\", color=\\\"black\\\", alpha=0.35)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ---------------- Region labels ----------------\\n\",\n",
    "    \"regions = [\\n\",\n",
    "    \"    (\\\"Translation\\\", 160, 1.0, 0.5, 1.5),\\n\",\n",
    "    \"    (\\\"Rotation\\\",    520, 2.0, 1.5, 2.5),\\n\",\n",
    "    \"    (\\\"Vibration\\\",  6500, 3.0, 2.5, 3.5),\\n\",\n",
    "    \"]\\n\",\n",
    "    \"\\n\",\n",
