    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"M_WATER = 0.01801528\\n\",\n",
    "    \"\\n\",\n",
    "    \"A = -203.6060\\n\",\n",
    "    \"B = 1523.290\\n\",\n",
    "    \"C = -3196.413\\n\",\n",
    "    \"D = 2474.455\\n\",\n",
    "    \"E = 3.855326\\n\",\n",
    "    \"\\n\",\n",
    "    \"def cp_water_mass(T_celsius):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Specific heat capacity of liquid water at 1 bar as a function of temperature.\\n\",\n",
    "    \"    Input:  T_celsius (float or array), temperature in °C\\n\",\n",
    "    \"    Output: cp in J/(kg·K)\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    T_kelvin = T_celsius + 273.15\\n\",\n",
    "    \"    t = T_kelvin / 1000.0\\n\",\n",
    "    \"\\n\",\n",
    "    \"    cp_molar = A + B*t + C*t**2 + D*t**3 + E / (t**2)  # J/mol/K\\n\",\n",
    "    \"    return cp_molar / M_WATER                           # J/kg/K\\n\",\n",
    "    \"\\n\",\n",
    "    \"T = np.linspace(0.0, 100.0, 500)\\n\",\n",
    "    \"cp = cp_water_mass(T)\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig, ax = plt.subplots()\\n\",\n",
    "    \"\\n\",\n",
    "    \"ax.plot(T, cp, lw=2, color=\\\"purple\\\")\\n\",\n",
    "    \"ax.set_xlabel(\\\"Temperature (°C)\\\")\\n\",\n",
    "    \"ax.set_ylabel(r\\\"Specific heat capacity $c_p$ (J kg$^{-1}$ K$^{-1}$)\\\")\\n\",\n",
    "    \"ax.set_title(\\\"Specific heat of water as a function of temperature\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"T0, T100 = 0.0, 100.0\\n\",\n",
    "    \"cp0   = cp_water_mass(T0)\\n\",\n",
    "    \"cp100 = cp_water_mass(T100)\\n\",\n",
    "    \"# ax.scatter([T0, T100], [cp0, cp100], zorder=3, color=\\\"red\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ax.hlines(cp0,   xmin=-20.0, xmax=T0, linestyles=\\\"dashed\\\", alpha=0.7, color=\\\"red\\\")\\n\",\n",
    "    \"# ax.hlines(cp100, xmin=-20.0, xmax=T100, linestyles=\\\"dashed\\\", alpha=0.7, color=\\\"red\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"x_arrow = -2.0\\n\",\n",
    "    \"y_low, y_high = min(cp0, cp100), max(cp0, cp100)\\n\",\n",
    "    \"\\n\",\n",
    "    \"ax.annotate(\\n\",\n",
    "    \"    \\\"\\\", xy=(x_arrow, y_high), xytext=(x_arrow, y_low),\\n\",\n",
    "    \"    arrowprops=dict(arrowstyle=\\\"<->\\\", lw=1.5)\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"delta_cp = cp100 - cp0  # will be about -5.6 J kg^-1 K^-1\\n\",\n",
    "    \"y_mid = 0.5 * (y_low + y_high)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ax.text(\\n\",\n",
    "    \"#     x_arrow + 2, y_mid,\\n\",\n",
    "    \"#     rf\\\"$\\\\Delta c_p \\\\approx {delta_cp:+.1f}\\\\ \\\\mathrm{{J\\\\,kg^{{-1}}K^{{-1}}}}$\\\",\\n\",\n",
    "    \"#     va=\\\"center\\\"\\n\",\n",
    "    \"# )\\n\",\n",
    "    \"\\n\",\n",
    "    \"# tidy limits so the arrow and text fit nicely\\n\",\n",
    "    \"ax.set_xlim(0, 100)\\n\",\n",
    "    \"ax.set_ylim(4100, 4280)\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig.tight_layout()\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"glue(\\\"cp_water_delta_fig\\\", fig, display=False)\"\n",
