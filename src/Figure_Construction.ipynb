    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"## Pressure-Temperature Graph with path ambiguity\",\n",
    "   \"id\": \"b09666e7b0595c23\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"tags\": [\n",
    "     \"remove-input\"\n",
    "    ],\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-02-02T18:32:28.915141Z\",\n",
    "     \"start_time\": \"2026-02-02T18:32:28.727975600Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"# Create figure\\n\",\n",
    "    \"fig, ax = plt.subplots(figsize=(7.2, 4.8), dpi=200, facecolor=\\\"k\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Normalised coordinates for a clean schematic\\n\",\n",
    "    \"Ti, Tf = 1.0, 4.0\\n\",\n",
    "    \"Pi, Pf = 1.0, 4.0\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Path 1 (orange): vertical then horizontal\\n\",\n",
    "    \"T_path1 = [Ti, Ti, Tf]\\n\",\n",
    "    \"P_path1 = [Pi, Pf, Pf]\\n\",\n",
    "    \"ax.plot(T_path1, P_path1, lw=3, solid_capstyle=\\\"round\\\", color='orange')\\n\",\n",
    "    \"ax.annotate(\\\"\\\", xy=(Ti, Pf), xytext=(Ti, Pi),\\n\",\n",
    "    \"            arrowprops=dict(arrowstyle=\\\"->\\\", lw=3, color='orange'))\\n\",\n",
    "    \"ax.annotate(\\\"\\\", xy=(Tf, Pf), xytext=(Ti, Pf),\\n\",\n",
    "    \"            arrowprops=dict(arrowstyle=\\\"->\\\", lw=3, color='orange'))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Path 2 (blue): smooth curve from (Ti, Pi) to (Tf, Pf)\\n\",\n",
    "    \"t = np.linspace(0, 1, 200)\\n\",\n",
    "    \"T_curve = Ti + (Tf - Ti) * t\\n\",\n",
    "    \"\\n\",\n",
    "    \"# A gentler convex-up curve\\n\",\n",
    "    \"P_curve = Pi + (Pf - Pi) * (t**1.6)\\n\",\n",
    "    \"ax.plot(T_curve, P_curve, lw=3, color='blue')\\n\",\n",
    "    \"ax.annotate(\\\"\\\", xy=(T_curve[int(0.72*len(t))], P_curve[int(0.72*len(t))]),\\n\",\n",
    "    \"            xytext=(T_curve[int(0.60*len(t))], P_curve[int(0.60*len(t))]),\\n\",\n",
    "    \"            arrowprops=dict(arrowstyle=\\\"->\\\", lw=3, color='blue'))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Labelling each path\\n\",\n",
    "    \"ax.text((Ti+Tf)/2 - 0.2, Pf + 0.12, \\\"Path 1\\\", fontsize=12, color='orange')\\n\",\n",
    "    \"ax.text((Ti+Tf)/2 + 0.55, (Pi+Pf)/2 - 0.3, \\\"Path 2\\\", fontsize=12, color='blue')\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Axis formatting\\n\",\n",
    "    \"ax.set_xlim(0.3, 4.7)\\n\",\n",
    "    \"ax.set_ylim(0.3, 4.7)\\n\",\n",
    "    \"ax.set_xlabel(\\\"Temperature, $T$\\\", fontsize=13)\\n\",\n",
    "    \"ax.set_ylabel(\\\"Pressure, $p$\\\", fontsize=13)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Mark Ti, Tf, Pi, Pf with ticks and labels\\n\",\n",
    "    \"ax.set_xticks([Ti, Tf])\\n\",\n",
    "    \"ax.set_xticklabels([r\\\"$T_i$\\\", r\\\"$T_f$\\\"], fontsize=12)\\n\",\n",
    "    \"ax.set_yticks([Pi, Pf])\\n\",\n",
    "    \"ax.set_yticklabels([r\\\"$p_i$\\\", r\\\"$p_f$\\\"], fontsize=12)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Add points\\n\",\n",
    "    \"ax.scatter([Ti, Tf, Ti], [Pi, Pf, Pf], s=35, zorder=5, color='black')\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Make it schematic: remove top/right spines, keep arrows on axes\\n\",\n",
    "    \"ax.spines[\\\"top\\\"].set_visible(False)\\n\",\n",
    "    \"ax.spines[\\\"right\\\"].set_visible(False)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Add arrowheads to axes\\n\",\n",
    "    \"ax.annotate(\\\"\\\", xy=(4.65, 0.3), xytext=(0.3, 0.3),\\n\",\n",
    "    \"            arrowprops=dict(arrowstyle=\\\"->\\\", lw=2))\\n\",\n",
    "    \"ax.annotate(\\\"\\\", xy=(0.3, 4.65), xytext=(0.3, 0.3),\\n\",\n",
    "    \"            arrowprops=dict(arrowstyle=\\\"->\\\", lw=2))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Hide bottom/left spines since we drew arrows\\n\",\n",
    "    \"ax.spines[\\\"bottom\\\"].set_visible(False)\\n\",\n",
    "    \"ax.spines[\\\"left\\\"].set_visible(False)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Light grid\\n\",\n",
    "    \"ax.grid(True, which=\\\"both\\\", alpha=0.25)\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig.tight_layout()\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Save figure\\n\",\n",
    "    \"fig.savefig(\\\"Temperature-Pressure_Paths.png\\\")\"\n",
    "   ],\n",
